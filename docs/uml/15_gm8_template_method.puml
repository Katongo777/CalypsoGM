class "PantallaSeleccion" as PantallaSeleccion {
  -personajes : Personaje[]
  -seleccionado : int
  -pixel : Texture
  -iniciar : boolean
  -ultimoMouseX : float
  -ultimoMouseY : float
  --
  +<<create>> PantallaSeleccion(game : SpaceNavigation)
  #actualizar(delta : float) : void
  #dibujar() : void
  -dibujarTarjeta(batch : SpriteBatch, font : BitmapFont, p : Personaje, x : float, y : float, activa : boolean) : void
  #revisarTransicion() : void
  +show() : void
}
class "PantallaVictoria" as PantallaVictoria {
  -{static} CANTIDAD_CONFETI : int {readOnly}
  -score : int
  -nuevoRecord : boolean
  -confetiX : float[]
  -confetiY : float[]
  -confetiVel : float[]
  -confetiColor : Color[]
  --
  +<<create>> PantallaVictoria(game : SpaceNavigation, score : int, nuevoRecord : boolean)
  #actualizar(delta : float) : void
  #dibujar() : void
  #revisarTransicion() : void
  +show() : void
}
}
package "LibGDX (biblioteca)" #EEF3FB {
abstract class "Game" as Game <<LibGDX>> {
  + create() : void
  + render() : void
  + dispose() : void
  + setScreen(screen : Screen) : void
  + getScreen() : Screen
}
interface "Screen" as Screen <<LibGDX>> {
  + show() : void
  + render(delta : float) : void
  + resize(width : int, height : int) : void
  + pause() : void
  + resume() : void
  + hide() : void
  + dispose() : void
}
}
Game --> "1" Screen : screen
Screen <|.. PantallaBase
PantallaBase --> "1" SpaceNavigation : game
PantallaBase <|-- PantallaGameOver
PantallaGameOver ..> PantallaSeleccion
PantallaGameOver ..> SpaceNavigation
PantallaBase <|-- PantallaGuia
PantallaGuia ..> PantallaMenu
PantallaGuia ..> PantallaSeleccion
PantallaGuia ..> SpaceNavigation
PantallaBase <|-- PantallaJuego
PantallaJuego ..> PantallaGameOver
PantallaJuego ..> PantallaMenu
PantallaJuego ..> PantallaOpciones
PantallaJuego ..> PantallaVictoria
PantallaJuego ..> SpaceNavigation
PantallaBase <|-- PantallaMenu
PantallaMenu ..> PantallaGuia
PantallaMenu ..> PantallaOpciones
PantallaMenu ..> PantallaSeleccion
PantallaMenu ..> SpaceNavigation
PantallaBase <|-- PantallaOpciones
PantallaOpciones --> "1" Screen : volverA
PantallaOpciones ..> SpaceNavigation
PantallaBase <|-- PantallaSeleccion
PantallaSeleccion ..> PantallaJuego
PantallaSeleccion ..> PantallaMenu
PantallaSeleccion ..> SpaceNavigation
PantallaBase <|-- PantallaVictoria
PantallaVictoria ..> PantallaSeleccion
PantallaVictoria ..> SpaceNavigation
Game <|-- SpaceNavigation
SpaceNavigation ..> PantallaMenu
SpaceNavigation ..> Screen
@enduml
