  -{static} VOLVER : int {readOnly}
  -volverA : Screen
  -opciones : Opciones
  -volver : boolean
  --
  +<<create>> PantallaOpciones(game : SpaceNavigation, volverA : Screen)
  #actualizar(delta : float) : void
  -cambiar(opcion : int, paso : int) : void
  -siguienteVolumen(actual : float, paso : int) : float
  -actualizarEtiquetas() : void
  #dibujar() : void
  #revisarTransicion() : void
